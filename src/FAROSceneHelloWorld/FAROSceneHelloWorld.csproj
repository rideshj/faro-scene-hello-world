<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target .NET Framework 4.8 as required by modern 64-bit FARO SCENE versions -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>FAROSceneHelloWorld</RootNamespace>
    <AssemblyName>FAROSceneHelloWorld</AssemblyName>
    
    <!-- Enforce 64-bit architecture (FARO SCENE is strictly a 64-bit application) -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release</Configurations>
    
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- Debug Configuration -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Release Configuration -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- SDK Reference Path Discovery:
       1. Prioritize FARO_SCENE_DIR environment variable or default installation path.
       2. Fallback to repository 'lib' reference folder for build environments without SCENE installed.
  -->
  <PropertyGroup>
    <FARO_SCENE_DIR Condition="'$(FARO_SCENE_DIR)' == ''">C:\Program Files\FARO\SCENE</FARO_SCENE_DIR>
    <FARO_REF_DIR Condition="Exists('$(FARO_SCENE_DIR)\FARO.LS.SDK.AppLogic.dll')">$(FARO_SCENE_DIR)</FARO_REF_DIR>
    <FARO_REF_DIR Condition="'$(FARO_REF_DIR)' == ''">$(MSBuildThisFileDirectory)..\..\lib</FARO_REF_DIR>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard Desktop Framework Assemblies -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Numerics" />

    <!-- FARO SCENE SDK Assembly References
         CRITICAL CONSTRAINT: Private=False (CopyLocal=False) must be strictly enforced.
         FARO SCENE provides these assemblies in its host AppDomain at runtime.
         Shipping them inside the .faroapp package causes assembly collision and load failures.
    -->
    <Reference Include="FARO.LS.SDK.AppLogic">
      <HintPath>$(FARO_REF_DIR)\FARO.LS.SDK.AppLogic.dll</HintPath>
      <Private>False</Private>
      <CopyLocal>False</CopyLocal>
    </Reference>
    <Reference Include="FARO.LS.SDK.DataLogic">
      <HintPath>$(FARO_REF_DIR)\FARO.LS.SDK.DataLogic.dll</HintPath>
      <Private>False</Private>
      <CopyLocal>False</CopyLocal>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- App Manifest and Resource Assets for Packaging -->
    <None Include="App.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="AppManifest.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
